/**
 * InDesign entry point for the in-host suite (suite.js), run as a UXP script by run.mjs.
 */
const indesign            = require('indesign');
const uxp                 = require('uxp');
const fs                  = require('fs');

const config                = require('./config.generated.js');
const { runSuite }          = require('./suite.js');
const { InDesignDocuments } = require('../../src/host/InDesignDocuments.js');
const { Platform }          = require('../../src/host/Platform.js');

const { app }             = indesign;
const { localFileSystem } = uxp.storage;

/**
 * InDesign fixture: creates and saves documents with the InDesign DOM.
 * @param {{ result: object, writeResult: () => void }} tracking
 * @returns {object}
 */
const createFixture = ({ result, writeResult }) => ({
    hostName  : 'InDesign',
    extension : '.indd',
    documents : new InDesignDocuments({ app }),
    createSavedDocument : async (path) => {
        const document = app.documents.add();
        // Recorded before saving so cleanup can close it by name even if the save fails.
        result.untitledNames.push(document.name);
        writeResult();
        await document.save(await localFileSystem.createEntryWithUrl(`file:${path}`, { overwrite : true }));
        return document;
    },
    createUntitledDocument : async () => {
        const document = app.documents.add();
        result.untitledNames.push(document.name);
        writeResult();
        return document.name;
    },
    closeDocument : async (document) => {
        document.close(indesign.SaveOptions.NO);
    },
    closeSuiteDocuments : async (prefix) => {
        const openNow = [];
        for (let index = 0; index < app.documents.length; index++) {
            openNow.push(app.documents.item(index));
        }
        for (const document of openNow) {
            try {
                const entry = await document.fullName;
                if (entry.nativePath.startsWith(prefix)) {
                    document.close(indesign.SaveOptions.NO);
                }
            }
            catch (_error) {
                // Untitled documents are closed by run.mjs by recorded name.
            }
        }
    },
});

// Top-level await keeps the script alive until every asynchronous step has finished.
await runSuite({
    fs,
    platform : new Platform({ fs, localFileSystem, shell : uxp.shell }),
    config,
    createFixture,
});
